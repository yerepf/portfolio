---
import BaseLayout from './BaseLayout.astro';
import {
  getLocalizedContent,
  getLocalizedTitle,
  getLocalizedDescription,
  getRelatedPosts,
  formatDate,
  renderMarkdown,
  getPostSlug,
  getProjectsForPost,
  type BlogPost,
} from '../utils/blog';
import { getTranslationSync, getCategoryLabel, type Locale } from '../i18n';
import { getLocalizedText } from '../utils/content';

interface Props {
  post: BlogPost;
  locale: Locale;
}

const { post, locale } = Astro.props;
const t = getTranslationSync(locale);

const title = getLocalizedTitle(post.data, locale);
const description = getLocalizedDescription(post.data, locale);
const content = renderMarkdown(getLocalizedContent(post.data, locale));
const relatedPosts = await getRelatedPosts(getPostSlug(post), locale, 3);
const relatedProjects = await getProjectsForPost(post);

const siteUrl = new URL(Astro.url.pathname, Astro.site).toString();
const shareText = encodeURIComponent(`${title} — ${description}`);
const shareUrl = encodeURIComponent(siteUrl);
const mailSubject = encodeURIComponent(title);
const mailBody = encodeURIComponent(`${title}\n\n${description}\n\n${siteUrl}`);

const projectsUrl = locale === 'es' ? '/es/#projects' : '/#projects';
---

<BaseLayout locale={locale} ogImage={post.data.image ?? '/profile.png'}>
  <article class="blog-post">
    <header class="blog-post__header">
      {post.data.category && (
        <span class="blog-post__category">{getCategoryLabel(post.data.category, locale)}</span>
      )}
      <h1 class="blog-post__title">{title}</h1>
      <p class="blog-post__description">{description}</p>
      <div class="blog-post__meta">
        <time datetime={post.data.date.toISOString()} class="blog-post__date">
          {formatDate(post.data.date, locale)}
        </time>
        {post.data.readingTime && (
          <span class="blog-post__read-time">
            {post.data.readingTime} {t.blog.readTime}
          </span>
        )}
        {post.data.author && (
          <span class="blog-post__author">{t.blog.by} {post.data.author}</span>
        )}
      </div>
      {post.data.image && (
        <figure class="blog-post__cover">
          <img src={post.data.image} alt={title} />
        </figure>
      )}
      {post.data.tags?.length && (
        <div class="blog-post__tags">
          {post.data.tags.map(tag => (
            <span class="tag">
              <span class="tag-name">{tag}</span>
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="blog-post__content" set:html={content} />

    <footer class="blog-post__footer">
      {relatedProjects.length > 0 && (
        <section class="blog-post__related-projects">
          <h3>{t.blog.relatedProjects}</h3>
          <p>{t.blog.relatedProjectsDesc}</p>
          <div class="blog-post__related-grid">
            {relatedProjects.map(project => (
              <article class="blog-post__related-card">
                {project.data.image && (
                  <div class="blog-post__related-image">
                    <img src={project.data.image} alt={getLocalizedText(project.data.title, locale)} />
                  </div>
                )}
                <div class="blog-post__related-content">
                  <h4>
                    <a href={projectsUrl}>{getLocalizedText(project.data.title, locale)}</a>
                  </h4>
                  <p>{getLocalizedText(project.data.description, locale)}</p>
                  <div class="blog-post__related-links">
                    {project.data.link && (
                      <a href={project.data.link} target="_blank" rel="noopener noreferrer">{t.projects.view}</a>
                    )}
                    {project.data.github && (
                      <a href={project.data.github} target="_blank" rel="noopener noreferrer">{t.projects.github}</a>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {relatedPosts.length > 0 && (
        <section class="blog-post__related-posts">
          <h3>{t.blog.relatedPosts}</h3>
          <div class="blog-post__related-grid">
            {relatedPosts.map(related => (
              <article class="blog-post__related-card">
                {related.data.image && (
                  <div class="blog-post__related-image">
                    <img src={related.data.image} alt={getLocalizedTitle(related.data, locale)} />
                  </div>
                )}
                <div class="blog-post__related-content">
                  <h4>
                    <a href={related.url}>{getLocalizedTitle(related.data, locale)}</a>
                  </h4>
                  <time datetime={related.data.date.toISOString()}>
                    {formatDate(related.data.date, locale)}
                  </time>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      <nav class="blog-post__share">
        <span>{t.blog.share}</span>
        <a
          href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.blog.shareTwitter}
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
        </a>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.blog.shareLinkedIn}
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href={`mailto:?subject=${mailSubject}&body=${mailBody}`} aria-label={t.blog.shareEmail}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .blog-post {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 2rem;
    font-family: var(--vhs-font-reading);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--vhs-cream);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .blog-post :is(h1, h2, h3, h4),
  .blog-post__category,
  .blog-post__meta,
  .blog-post :is(code, pre),
  .tag,
  .blog-post__share {
    font-family: var(--vhs-font-display);
  }

  .blog-post__header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 236, 200, 0.15);
  }

  .blog-post__category {
    display: inline-block;
    font-size: 0.7rem;
    text-transform: uppercase;
    font-weight: 600;
    color: #c7ff6b;
    background: rgba(199, 255, 107, 0.15);
    border: 1px solid rgba(199, 255, 107, 0.4);
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    letter-spacing: 1px;
    margin-bottom: 1.5rem;
  }

  .blog-post__title {
    margin: 0 0 1rem 0;
    color: var(--vhs-cream);
    font-size: 2.75rem;
    line-height: 1.15;
    text-shadow: 0 1px 0 #000, 0 0 20px rgba(255, 224, 170, 0.4);
  }

  .blog-post__description {
    margin: 0 0 1.5rem 0;
    color: var(--vhs-warm);
    font-size: 1.1875rem;
    line-height: 1.6;
    font-style: italic;
  }

  .blog-post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
    letter-spacing: 0.5px;
    color: var(--vhs-muted);
  }

  .blog-post__date,
  .blog-post__read-time,
  .blog-post__author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .blog-post__cover {
    margin: 2rem -2rem;
    border-radius: 0;
  }

  .blog-post__cover img {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
  }

  .blog-post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    background: rgba(199, 255, 107, 0.15);
    border: 1px solid rgba(199, 255, 107, 0.6);
    color: #c7ff6b;
    font-size: 0.75rem;
    text-transform: uppercase;
    border-radius: 4px;
  }

  .blog-post__footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 236, 200, 0.15);
  }

  .blog-post__related-projects,
  .blog-post__related-posts {
    margin-bottom: 3rem;
  }

  .blog-post__related-projects h3,
  .blog-post__related-posts h3 {
    margin: 0 0 0.5rem 0;
    color: #f2e8d5;
    font-size: 1.5rem;
    text-shadow: 0 1px 0 #000, 0 0 10px rgba(255, 224, 170, 0.3);
  }

  .blog-post__related-projects p {
    color: var(--vhs-cream);
    margin-bottom: 1.5rem;
  }

  .blog-post__related-content > p {
    color: var(--vhs-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0.5rem 0 0.75rem;
  }

  .blog-post__related-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .blog-post__related-links a {
    color: #c7ff6b;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    border-bottom: 1px solid rgba(199, 255, 107, 0.4);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }

  .blog-post__related-links a:hover {
    color: var(--vhs-cream);
    border-color: var(--vhs-cream);
  }

  .blog-post__related-links a:focus-visible {
    outline: 2px solid #c7ff6b;
    outline-offset: 2px;
  }

  .blog-post__related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .blog-post__related-card {
    background: #0f0f0f;
    border: 1px solid rgba(255, 236, 200, 0.15);
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .blog-post__related-card:hover {
    border-color: rgba(199, 255, 107, 0.4);
    box-shadow: 0 0 20px rgba(199, 255, 107, 0.1);
  }

  .blog-post__related-image {
    height: 160px;
    overflow: hidden;
  }

  .blog-post__related-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .blog-post__related-card:hover .blog-post__related-image img {
    transform: scale(1.05);
  }

  .blog-post__related-content {
    padding: 1rem;
  }

  .blog-post__related-content h4 {
    margin: 0 0 0.5rem 0;
    font-size: 1rem;
  }

  .blog-post__related-content h4 a {
    color: #f2e8d5;
    text-decoration: none;
  }

  .blog-post__related-content h4 a:hover {
    color: #c7ff6b;
  }

  .blog-post__related-content time {
    font-size: 1rem;
    letter-spacing: 0.5px;
    color: var(--vhs-muted);
  }

  .blog-post__share {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 236, 200, 0.15);
    color: var(--vhs-muted);
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .blog-post__share a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--vhs-warm);
    border: 1px solid rgba(224, 194, 139, 0.4);
    border-radius: 50%;
    transition: all 0.2s ease;
  }

  .blog-post__share a:hover {
    color: #c7ff6b;
    border-color: #c7ff6b;
    background: rgba(199, 255, 107, 0.1);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .blog-post {
      padding: 2rem 1rem;
    }

    .blog-post__title {
      font-size: 2.125rem;
    }

    .blog-post__description {
      font-size: 1.0625rem;
    }

    .blog-post__cover {
      margin: 2rem -1rem;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .blog-post__related-card,
    .blog-post__related-image img,
    .blog-post__share a {
      transition: none;
    }

    .blog-post__related-card:hover .blog-post__related-image img,
    .blog-post__share a:hover {
      transform: none;
    }
  }
</style>

<!-- El contenido Markdown se inyecta con set:html: Astro NO anade
     data-astro-cid a esos nodos, asi que este bloque debe ser global. -->
<style is:global>
.blog-post__content {
  color: var(--vhs-cream);
  font-size: 1.0625rem;
  line-height: 1.75;
  hyphens: auto;
  -webkit-hyphens: auto;
}

.blog-post__content :is(h1, h2, h3, h4, h5, h6) {
  color: var(--vhs-cream);
  line-height: 1.3;
  letter-spacing: 0.5px;
  text-transform: none;
  text-shadow: 0 1px 0 #000, 0 0 10px rgba(255, 224, 170, 0.3);
}

.blog-post__content > *:first-child {
  margin-top: 0;
}

.blog-post__content h1 { font-size: 2.25rem; margin: 2.75rem 0 1rem; }
.blog-post__content h2 { font-size: 1.875rem; margin: 2.75rem 0 1rem; }
.blog-post__content h3 { font-size: 1.5rem; margin: 2.25rem 0 0.75rem; }
.blog-post__content h4 { font-size: 1.25rem; margin: 1.75rem 0 0.5rem; }
.blog-post__content h5 { font-size: 1.125rem; margin: 1.5rem 0 0.5rem; color: var(--vhs-warm); }
.blog-post__content h6 {
  font-size: 1rem;
  margin: 1.25rem 0 0.5rem;
  color: var(--vhs-warm);
  text-transform: uppercase;
  letter-spacing: 1.5px;
}

.blog-post__content p {
  margin-bottom: 1.5rem;
}

.blog-post__content strong {
  color: var(--vhs-cream);
  font-weight: 700;
}

.blog-post__content em {
  color: var(--vhs-cream);
}

.blog-post__content del {
  color: var(--vhs-muted);
  text-decoration-color: rgba(199, 255, 107, 0.6);
  text-decoration-thickness: 2px;
}

.blog-post__content a {
  color: #c7ff6b;
  text-decoration: underline;
  text-underline-offset: 2px;
}

.blog-post__content a:hover {
  color: var(--vhs-cream);
}

.blog-post__content code {
  background: rgba(199, 255, 107, 0.12);
  color: #d7f7a0;
  padding: 0.15em 0.35em;
  border-radius: 3px;
  font-size: 0.95em;
}

.blog-post__code {
  position: relative;
  margin: 1.75rem -2rem;
}

.blog-post__code pre {
  background: var(--vhs-reading-bg);
  border: 1px solid rgba(199, 255, 107, 0.3);
  border-radius: 8px;
  padding: 1.5rem;
  margin: 0;
  overflow-x: auto;
  line-height: 1.5;
}

.blog-post__code::before {
  content: attr(data-lang);
  position: absolute;
  top: 0;
  right: 0;
  padding: 0.2rem 0.7rem;
  font-family: var(--vhs-font-display);
  font-size: 0.9rem;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--vhs-muted);
  background: rgba(199, 255, 107, 0.1);
  border-left: 1px solid rgba(199, 255, 107, 0.3);
  border-bottom: 1px solid rgba(199, 255, 107, 0.3);
  border-radius: 0 8px 0 8px;
  pointer-events: none;
}

.blog-post__code pre code {
  background: transparent;
  padding: 0;
  color: var(--vhs-cream);
  font-size: 0.9rem;
  line-height: 1.55;
  tab-size: 2;
}

.blog-post__content blockquote {
  border-left: 3px solid #c7ff6b;
  margin: 1.75rem 0;
  color: var(--vhs-cream);
  font-style: italic;
  background: rgba(199, 255, 107, 0.05);
  padding: 1rem 1.5rem;
  border-radius: 0 8px 8px 0;
}

.blog-post__content ul,
.blog-post__content ol {
  margin: 1.25rem 0;
  padding-left: 1.75rem;
}

.blog-post__content li {
  margin-bottom: 0.6rem;
}

.blog-post__content li::marker {
  color: #c7ff6b;
}

.blog-post__content li > ul,
.blog-post__content li > ol {
  margin: 0.6rem 0 0.4rem;
}

.blog-post__content li > p {
  margin-bottom: 0.4rem;
}

.blog-post__content li > p:last-child {
  margin-bottom: 0;
}

.blog-post__content li > input[type='checkbox'] {
  appearance: none;
  width: 1rem;
  height: 1rem;
  margin-right: 0.5rem;
  border: 1px solid rgba(199, 255, 107, 0.5);
  border-radius: 3px;
  background: transparent;
  vertical-align: baseline;
}

.blog-post__content li > input[type='checkbox']:checked {
  background: var(--vhs-accent);
  box-shadow: inset 0 0 0 2px var(--vhs-bg);
}

.blog-post__content li > input[type='checkbox']:disabled {
  cursor: default;
  opacity: 0.8;
}

.blog-post__content img {
  max-width: 100%;
  height: auto;
  border-radius: 8px;
  margin: 1.75rem 0;
}

.blog-post__content hr {
  border: none;
  border-top: 1px solid rgba(255, 236, 200, 0.15);
  margin: 3rem 0;
}

.blog-post__table-wrapper {
  overflow-x: auto;
  margin: 1.5rem 0;
}

.blog-post__content table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

.blog-post__content th[align='right'],
.blog-post__content td[align='right'] {
  text-align: right;
}

.blog-post__content th[align='center'],
.blog-post__content td[align='center'] {
  text-align: center;
}

.blog-post__content th,
.blog-post__content td {
  border: 1px solid rgba(255, 236, 200, 0.15);
  padding: 0.7rem 1rem;
  text-align: left;
}

.blog-post__content th {
  color: #f2e8d5;
  background: rgba(199, 255, 107, 0.08);
  font-weight: 600;
  white-space: nowrap;
}

  @media (max-width: 768px) {
    .blog-post__content h1 { font-size: 1.875rem; }
    .blog-post__content h2 { font-size: 1.625rem; }
    .blog-post__content h3 { font-size: 1.375rem; }

    .blog-post__code {
      margin: 1.5rem -1rem;
    }

    .blog-post__code pre {
      padding: 1rem;
    }
  }
</style>
