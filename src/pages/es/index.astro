---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Experience from '../../components/Experience.astro';
import Projects from '../../components/Projects.astro';
import Certifications from '../../components/Certifications.astro';
import { getTranslationSync } from '../../i18n';

const locale = 'es';
const t = getTranslationSync(locale);
---

<BaseLayout locale={locale}>
  <div class="main-layout">
    <Hero
      image="/profile.png"
      title="Yeremy Pujols" 
      subtitle="Soy un desarrollador fullstack!"
      locale={locale}
      ctaHref="#experience"
    />
    
    <main class="container">
      <section id="experience" class="experience-section">
        <h2>{t.experience.title}</h2>
        <Experience locale={locale} />
      </section>
      <section id="projects" class="projects-section">
        <h2>Mis Proyectos</h2>
        <Projects locale={locale} />
      </section>
      <section id="certifications" class="certifications-section">
        <h2>Certificaciones</h2>
        <Certifications locale={locale} />
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .main-layout {
    display: block;
    min-height: 100vh;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem;
  }

  .experience-section,
  .projects-section,
  .certifications-section {
    scroll-margin-top: 80px;
  }

  .experience-section h2,
  .projects-section h2 {
    text-align: center;
    margin-bottom: 0rem;
    color: #e0c28b;
    text-shadow: 0 0 20px #e0c28b;
    font-size: 2rem;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .projects-section,
  .certifications-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 236, 200, 0.15);
  }

  .certifications-section h2 {
    text-align: center;
    margin-bottom: 1.5rem;
    color: #e0c28b;
    text-shadow: 0 0 20px #e0c28b;
    font-size: 2rem;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  @media (max-width: 768px) {
    .container {
      padding: 1.5rem;
    }

    .experience-section h2,
    .projects-section h2,
    .certifications-section h2 {
      font-size: 1.5rem;
    }
  }


  @media (max-width: 480px) {
    .container {
      padding: 1rem;
    }

    .experience-section h2,
    .projects-section h2,
    .certifications-section h2 {
      font-size: 1.25rem;
    }

    .projects-section h2 {
      margin-bottom: 1.5rem;
    }
  }
</style>