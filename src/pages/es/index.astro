---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Experience from '../../components/Experience.astro';
import Projects from '../../components/Projects.astro';
import Certifications from '../../components/Certifications.astro';
import { getTranslationSync } from '../../i18n';

const locale = 'es';
const t = getTranslationSync(locale);
---

<BaseLayout locale={locale}>
  <div class="home-layout">
    <Hero
      image="/profile.png"
      title="Yeremy Pujols" 
      subtitle="Soy un desarrollador fullstack!"
      locale={locale}
      ctaHref="#experience"
    />
    
    <main class="home-container">
      <section id="experience" class="home-section">
        <h2 class="home-section__title">{t.experience.title}</h2>
        <Experience locale={locale} />
      </section>
      <section id="projects" class="home-section home-section--stack-title home-section--divided">
        <h2 class="home-section__title">Mis Proyectos</h2>
        <Projects locale={locale} />
      </section>
      <section id="certifications" class="home-section home-section--divided">
        <h2 class="home-section__title home-section__title--spaced">Certificaciones</h2>
        <Certifications locale={locale} />
      </section>
    </main>
  </div>
</BaseLayout>