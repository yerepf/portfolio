---
import { getTranslationSync, type Locale } from '../i18n';

interface Props {
  title: string;
  subtitle?: string;
  image: string;
  locale: Locale;
  ctaHref?: string;
}

const { title, subtitle, image, locale, ctaHref = '#experience' } = Astro.props;
const t = getTranslationSync(locale);
const heroSubtitle = subtitle ?? t.hero.subtitle;
---

<section class="hero">
    <div class="hero__container">
        <div class="hero__image-wrapper" id="heroImageWrapper">
            <div class="hero__image-inner" id="heroImageInner">
                <img src={image} alt={t.hero.imageAlt} class="hero__image hero__image--front"/>
                <img src={image} alt={t.hero.imageAlt} class="hero__image hero__image--back"/>
                <div class="hero__coin-edge"></div>
            </div>
        </div>
        <div class="hero__text">
            <p class="hero__eyebrow">{t.hero.eyebrow}</p>
            <h1 class="hero__title">{title}</h1>
            <p class="hero__subtitle">{heroSubtitle}</p>
        </div>
    </div>

    <a href={ctaHref} class="hero__cta">
        <span class="hero__cta-label">{t.hero.cta}</span>
        <span class="hero__cta-arrow" aria-hidden="true"></span>
    </a>
    <script>
        const wrapper = document.getElementById('heroImageWrapper') as HTMLElement | null;
        const inner = document.getElementById('heroImageInner') as HTMLElement | null;
        
        if (wrapper && inner && window.matchMedia('(min-width: 769px)').matches) {
            let targetRotation = 0;
            let currentRotation = 0;
            let isDragging = false;
            let lastX = 0;
            let velocity = 0;
            let autoRotate = 0.2;
            
            wrapper.addEventListener('mousedown', (e: MouseEvent) => {
                isDragging = true;
                lastX = e.clientX;
                velocity = 0;
                autoRotate = 0;
                wrapper.style.cursor = 'grabbing';
                e.preventDefault();
            });
            
            document.addEventListener('mousemove', (e: MouseEvent) => {
                if (!isDragging) return;
                const deltaX = e.clientX - lastX;
                velocity = deltaX * 0.6;
                targetRotation += velocity;
                lastX = e.clientX;
            });
            
            document.addEventListener('mouseup', () => {
                if (!isDragging) return;
                isDragging = false;
                wrapper.style.cursor = 'grab';
                setTimeout(() => {
                    if (!isDragging) autoRotate = 0.15;
                }, 800);
            });
            
            function animate() {
                if (!isDragging) {
                    velocity *= 0.98;
                    targetRotation += velocity + autoRotate;
                } else {
                    currentRotation += (targetRotation - currentRotation) * 0.15;
                }
                if (!isDragging) {
                    currentRotation += (targetRotation - currentRotation) * 0.05;
                }
                inner!.style.transform = `rotateY(${currentRotation}deg)`;
                requestAnimationFrame(animate);
            }
            
            wrapper.style.cursor = 'grab';
            animate();
        }
    </script>
</section>

<style>
    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2.5rem;
        min-height: calc(100vh - 60px);
        padding: 3rem 2rem;
        text-align: center;
    }

    .hero__container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        max-width: 900px;
    }

    .hero__image-wrapper {
        perspective: 1200px;
        width: clamp(150px, 22vw, 230px);
        height: clamp(150px, 22vw, 230px);
        user-select: none;
    }

    .hero__image-inner {
        position: relative;
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        transition: none;
    }

    .hero__image {
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid color-mix(in srgb, var(--vhs-accent) 50%, transparent);
        box-shadow: 0 0 30px color-mix(in srgb, var(--vhs-accent) 25%, transparent);
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        pointer-events: none;
    }

    .hero__image--front {
        transform: rotateY(0deg) translateZ(6px);
    }

    .hero__image--back {
        transform: rotateY(180deg) translateZ(6px);
    }

    .hero__coin-edge {
        position: absolute;
        width: 12px;
        height: 100%;
        left: 50%;
        margin-left: -6px;
        border-radius: 0;
        background: linear-gradient(
            to right,
            color-mix(in srgb, var(--vhs-accent) 60%, transparent) 0%,
            color-mix(in srgb, var(--vhs-cream) 40%, transparent) 50%,
            color-mix(in srgb, var(--vhs-accent) 60%, transparent) 100%
        );
        transform: rotateY(90deg);
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        pointer-events: none;
        box-shadow: inset 0 0 8px color-mix(in srgb, var(--vhs-accent) 40%, transparent);
    }

    .hero__eyebrow {
        margin: 0 0 0.5rem;
        font-family: var(--vhs-font-reading);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 3px;
        color: var(--vhs-muted);
    }

    .hero__title {
        margin: 0;
        font-size: clamp(2.25rem, 6vw, 4rem);
        line-height: 1.1;
        color: var(--vhs-cream);
        text-shadow: 0 2px 0 var(--vhs-shadow-hard), 0 0 24px var(--vhs-glow-warm);
    }

    .hero__subtitle {
        margin: 0.75rem 0 0;
        font-family: var(--vhs-font-reading);
        font-size: clamp(1.05rem, 2.2vw, 1.4rem);
        line-height: 1.5;
        color: var(--vhs-warm);
    }

    .hero__cta {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: var(--vhs-accent);
    }

    .hero__cta-label {
        font-family: var(--vhs-font-display);
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        border: 1px solid color-mix(in srgb, var(--vhs-accent) 50%, transparent);
        border-radius: 4px;
        padding: 0.4rem 1.25rem;
        background: color-mix(in srgb, var(--vhs-accent) 10%, transparent);
        transition: background 0.25s ease, box-shadow 0.25s ease, color 0.25s ease;
    }

    .hero__cta:hover .hero__cta-label {
        background: color-mix(in srgb, var(--vhs-accent) 22%, transparent);
        box-shadow: 0 0 18px color-mix(in srgb, var(--vhs-accent) 45%, transparent);
        color: var(--vhs-cream);
    }

    .hero__cta:focus-visible {
        outline: 2px solid var(--vhs-accent);
        outline-offset: 4px;
    }

    .hero__cta-arrow {
        width: 2px;
        height: 28px;
        background: linear-gradient(to bottom, var(--vhs-accent), transparent);
        animation: hero-cta-bounce 1.8s ease-in-out infinite;
    }

    @keyframes hero-cta-bounce {
        0%, 100% { transform: translateY(0); opacity: 0.5; }
        50% { transform: translateY(7px); opacity: 1; }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero__cta-arrow {
            animation: none;
        }
    }

    @media (max-width: 768px) {
        .hero {
            min-height: calc(100vh - 60px);
            padding: 2rem 1rem;
            gap: 2rem;
        }

        .hero__container {
            gap: 1.5rem;
        }
    }

    @media (max-width: 480px) {
        .hero {
            padding: 1.5rem 1rem;
        }
    }
</style>