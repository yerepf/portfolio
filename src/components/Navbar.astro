---
import { getTranslationSync, type Locale, getOtherLocale } from '../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslationSync(locale);
const otherLocale = getOtherLocale(locale);
const otherUrl = getRelativeLocaleUrl(otherLocale, '/');

const localeHome = getRelativeLocaleUrl(locale, '/');

const themeOptions = [
  { key: 'light', label: t.aria.themeLight },
  { key: 'dark', label: t.aria.themeDark },
  { key: 'system', label: t.aria.themeSystem },
] as const;

const navItems = [
  { key: 'home', href: localeHome },
  { key: 'experience', href: `${localeHome}#experience` },
  { key: 'projects', href: `${localeHome}#projects` },
  { key: 'certifications', href: `${localeHome}#certifications` },
  { key: 'blog', href: getRelativeLocaleUrl(locale, '/blog/') },
  { key: 'contact', href: 'mailto:yypujols@hotmail.com' },
];
---

<nav class="vhs-nav">
  <div class="vhs-nav__scanlines"></div>
  <div class="vhs-nav__content">
    <div class="vhs-nav__logo">
      <span class="vhs-nav__logo-text">YerePF</span>
      <span class="vhs-nav__logo-glitch" aria-hidden="true">YerePF</span>
    </div>
    <ul class="vhs-nav__menu">
      {navItems.map((item) => (
        <li class="vhs-nav__item">
          <a href={item.href} class="vhs-nav__link">
            <span class="vhs-nav__link-text">{t.nav[item.key as keyof typeof t.nav]}</span>
            <span class="vhs-nav__link-glitch" aria-hidden="true">{t.nav[item.key as keyof typeof t.nav]}</span>
            <span class="vhs-nav__link-indicator"></span>
          </a>
        </li>
      ))}
    </ul>
    <div class="vhs-nav__actions">
      <a 
        href={otherUrl} 
        class="vhs-nav__lang-switch" 
        aria-label={t.aria.switchLanguage}
        title={otherLocale === 'en' ? 'English' : 'Español'}
      >
        {otherLocale.toUpperCase()}
      </a>
      <button
        class="vhs-nav__theme-toggle"
        type="button"
        data-theme-label={themeOptions.map((o) => o.label).join('|')}
        data-theme-order={themeOptions.map((o) => o.key).join('|')}
        aria-label={`${t.aria.toggleTheme}: ${t.aria.themeSystem}`}
        title={t.aria.toggleTheme}
      >
        <span class="vhs-nav__theme-icon vhs-nav__theme-icon--light" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="5"></circle><path d="M12 1v3M12 20v3M1 12h3M20 12h3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M19.8 4.2l-2.1 2.1M6.3 17.7l-2.1 2.1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
        </span>
        <span class="vhs-nav__theme-icon vhs-nav__theme-icon--dark" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"></path></svg>
        </span>
        <span class="vhs-nav__theme-icon vhs-nav__theme-icon--system" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><rect x="2.5" y="4" width="19" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"></rect><path d="M8.5 20h7M12 17v3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
        </span>
      </button>
    </div>
  </div>
</nav>

<button class="vhs-nav__toggle" aria-label={t.aria.openMenu} aria-expanded="false">
  <span class="vhs-nav__toggle-bar"></span>
  <span class="vhs-nav__toggle-bar"></span>
  <span class="vhs-nav__toggle-bar"></span>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.vhs-nav__toggle');
  const menu = document.querySelector<HTMLElement>('.vhs-nav__menu');

  const setMenuOpen = (open: boolean): void => {
    menu?.classList.toggle('vhs-nav__menu--open', open);
    toggle?.classList.toggle('vhs-nav__toggle--active', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };

  toggle?.addEventListener('click', () => {
    setMenuOpen(!menu?.classList.contains('vhs-nav__menu--open'));
  });

  menu?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (target?.closest('a')) setMenuOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenuOpen(false);
  });

  const themeToggle = document.querySelector<HTMLButtonElement>('.vhs-nav__theme-toggle');
  const themeMeta = document.querySelector<HTMLMetaElement>('meta[data-theme-color]');
  const themeColor: Record<string, string> = { dark: '#0a0a0a', light: '#efe6d2' };
  const parseList = (value?: string): string[] =>
    (value ?? '').split(/[|,]/).map((entry) => entry.trim()).filter(Boolean);
  const order = parseList(themeToggle?.dataset.themeOrder).length
    ? parseList(themeToggle?.dataset.themeOrder)
    : ['light', 'dark', 'system'];
  const labels = parseList(themeToggle?.dataset.themeLabel);
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: light)');
  const toggleLabel = themeToggle?.getAttribute('title') ?? 'Change theme';

  const resolve = (choice: string): string =>
    choice === 'system' ? (media.matches ? 'light' : 'dark') : choice;

  const paint = () => {
    const stored = root.dataset.themeChoice ?? 'system';
    const choice = order.includes(stored) ? stored : 'system';
    const active = order.indexOf(choice);
    root.dataset.themeChoice = choice;
    root.dataset.theme = resolve(choice);
    themeToggle?.setAttribute('data-theme-active', choice);
    themeToggle?.setAttribute('aria-label', `${toggleLabel}: ${labels[active] ?? choice}`);
    if (themeMeta) themeMeta.content = themeColor[root.dataset.theme] ?? themeColor.dark;
  };

  themeToggle?.addEventListener('click', () => {
    const stored = root.dataset.themeChoice ?? 'system';
    const index = order.indexOf(stored);
    const next = order[(index === -1 ? 0 : index + 1) % order.length];
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage unavailable: theme still applies for this page */
    }
    root.dataset.themeChoice = next;
    paint();
  });

  media.addEventListener('change', () => {
    if ((root.dataset.themeChoice ?? 'system') === 'system') paint();
  });

  paint();
</script>

<style>
  .vhs-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: var(--vhs-surface-elevated);
    border-bottom: 2px solid color-mix(in srgb, var(--vhs-accent) 40%, transparent);
    box-shadow: 0 0 20px color-mix(in srgb, var(--vhs-accent) 20%, transparent);
    font-family: var(--vhs-font-display);
  }

  .vhs-nav__scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0px,
      transparent 2px,
      var(--vhs-scanline-nav) 2px,
      var(--vhs-scanline-nav) 4px
    );
    pointer-events: none;
  }

  .vhs-nav__content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .vhs-nav__logo {
    position: relative;
    font-size: 2rem;
    font-weight: bold;
    color: var(--vhs-accent);
    text-shadow: 0 0 10px color-mix(in srgb, var(--vhs-accent) 80%, transparent);
  }

  .vhs-nav__logo-text {
    position: relative;
    z-index: 1;
  }

  .vhs-nav__logo-glitch {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--vhs-glitch);
    clip-path: polygon(0 0, 100% 0, 100% 45%, 0 45%);
    opacity: 0;
    animation: glitch-logo 3s infinite;
  }

  @keyframes glitch-logo {
    0%, 92%, 100% { opacity: 0; transform: translate(0); }
    93% { opacity: 0.8; transform: translate(-3px, -1px); }
    94% { opacity: 0; }
    95% { opacity: 0.6; transform: translate(2px, 1px); }
    96% { opacity: 0; }
  }

  .vhs-nav__menu {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .vhs-nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--vhs-accent) 50%, transparent);
    cursor: pointer;
  }

  .vhs-nav__toggle-bar {
    width: 24px;
    height: 3px;
    background: var(--vhs-accent);
    box-shadow: 0 0 6px color-mix(in srgb, var(--vhs-accent) 60%, transparent);
    transition: transform 0.2s, opacity 0.2s;
  }

  .vhs-nav__toggle--active .vhs-nav__toggle-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .vhs-nav__toggle--active .vhs-nav__toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .vhs-nav__toggle--active .vhs-nav__toggle-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .vhs-nav__item {
    position: relative;
  }

  .vhs-nav__link {
    position: relative;
    display: block;
    padding: 0.5rem 1rem;
    color: var(--vhs-cream);
    text-decoration: none;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: color 0.2s, text-shadow 0.2s;
  }

  .vhs-nav__link-text {
    position: relative;
    z-index: 1;
  }

  .vhs-nav__link-glitch {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--vhs-glitch);
    clip-path: polygon(0 0, 100% 0, 100% 50%, 0 50%);
    opacity: 0;
    white-space: nowrap;
  }

  .vhs-nav__link:hover .vhs-nav__link-text {
    color: var(--vhs-accent);
    text-shadow: 0 0 10px color-mix(in srgb, var(--vhs-accent) 80%, transparent);
  }

  .vhs-nav__link:hover .vhs-nav__link-glitch {
    animation: glitch-text 0.3s steps(2) infinite;
  }

  .vhs-nav__link:hover .vhs-nav__link-indicator {
    box-shadow: 0 0 12px color-mix(in srgb, var(--vhs-accent) 90%, transparent);
  }

  @keyframes glitch-text {
    0% { opacity: 0; transform: translate(-50%, -50%) translate(-2px, 0); }
    25% { opacity: 0.7; transform: translate(-50%, -50%) translate(2px, -1px); }
    50% { opacity: 0; transform: translate(-50%, -50%) translate(-1px, 1px); }
    75% { opacity: 0.5; transform: translate(-50%, -50%) translate(1px, 0); }
    100% { opacity: 0; transform: translate(-50%, -50%) translate(0, 0); }
  }

  .vhs-nav__link-indicator {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 2px;
    background: var(--vhs-accent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--vhs-accent) 60%, transparent);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .vhs-nav__link:hover .vhs-nav__link-indicator {
    opacity: 1;
  }

  .vhs-nav__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .vhs-nav__lang-switch {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 50px;
    height: 36px;
    padding: 0 0.75rem;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--vhs-accent) 50%, transparent);
    color: var(--vhs-accent);
    font-family: var(--vhs-font-display);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 4px;
  }

  .vhs-nav__lang-switch:hover {
    background: color-mix(in srgb, var(--vhs-accent) 15%, transparent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--vhs-accent) 40%, transparent);
    border-color: var(--vhs-accent);
  }

  .vhs-nav__theme-toggle {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 0.6rem;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--vhs-accent) 50%, transparent);
    border-radius: 4px;
    color: var(--vhs-accent);
    font-family: var(--vhs-font-display);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .vhs-nav__theme-toggle:hover {
    background: color-mix(in srgb, var(--vhs-accent) 15%, transparent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--vhs-accent) 40%, transparent);
    border-color: var(--vhs-accent);
  }

  .vhs-nav__theme-toggle:focus-visible {
    outline: 2px solid var(--vhs-accent);
    outline-offset: 3px;
  }

  .vhs-nav__theme-icon {
    display: none;
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .vhs-nav__theme-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .vhs-nav__theme-toggle[data-theme-active="light"] .vhs-nav__theme-icon--light,
  .vhs-nav__theme-toggle[data-theme-active="dark"] .vhs-nav__theme-icon--dark,
  .vhs-nav__theme-toggle[data-theme-active="system"] .vhs-nav__theme-icon--system {
    display: block;
  }

  @media (max-width: 768px) {
    .vhs-nav__toggle {
      display: flex;
      position: fixed;
      top: 0.75rem;
      right: 1rem;
      z-index: 1001;
      background: var(--vhs-surface-elevated);
    }

    .vhs-nav__content {
      padding: 0;
      flex-direction: column;
    }

    .vhs-nav__logo {
      display: none;
    }

    .vhs-nav__menu {
      position: fixed;
      top: 60px;
      left: 0;
      right: 0;
      flex-direction: column;
      background: var(--vhs-surface-solid);
      border-bottom: 2px solid color-mix(in srgb, var(--vhs-accent) 40%, transparent);
      padding: 1rem;
      gap: 0;
      transform: translateY(-100%);
      opacity: 0;
      visibility: hidden;
      transition: transform 0.3s, opacity 0.3s, visibility 0.3s;
    }

    .vhs-nav__menu--open {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .vhs-nav__link {
      padding: 1rem;
      border-bottom: 1px solid color-mix(in srgb, var(--vhs-accent) 20%, transparent);
      text-align: left;
    }

    .vhs-nav__link:last-child {
      border-bottom: none;
    }

    .vhs-nav__link-indicator {
      left: 1rem;
      transform: none;
      width: calc(100% - 2rem);
    }

    .vhs-nav__link-glitch {
      left: 1rem;
      transform: translateY(-50%);
    }

    .vhs-nav__actions {
      position: fixed;
      top: 0.75rem;
      left: 1rem;
      z-index: 1001;
    }

    .vhs-nav__lang-switch {
      background: var(--vhs-surface-elevated);
      border: 1px solid color-mix(in srgb, var(--vhs-accent) 50%, transparent);
    }

    @keyframes glitch-text {
      0% { opacity: 0; transform: translateY(-50%) translate(-2px, 0); }
      25% { opacity: 0.7; transform: translateY(-50%) translate(2px, -1px); }
      50% { opacity: 0; transform: translateY(-50%) translate(-1px, 1px); }
      75% { opacity: 0.5; transform: translateY(-50%) translate(1px, 0); }
      100% { opacity: 0; transform: translateY(-50%) translate(0, 0); }
    }
  }
</style>