---
import { getCollection, type CollectionEntry } from 'astro:content';
import { getTranslationSync, type Locale } from '../i18n';
import { getLocalizedText } from '../utils/content';
import { getTechIconUrl } from '../utils/icons';
import { getBlogPosts, normalizeRef } from '../utils/blog';

interface Props {
  limit?: number;
  locale: Locale;
}

const { limit, locale } = Astro.props;
const t = getTranslationSync(locale);
const projects = await getCollection('projects');
const posts = await getBlogPosts(locale);

const normalize = normalizeRef;

const postsByProject = new Map<string, { slug: string; url: string; title: string }[]>();

for (const post of posts) {
  for (const ref of post.data.relatedProjects ?? []) {
    const key = normalize(ref);
    const matches = projects.filter(project => normalize(project.id) === key);
    for (const match of matches) {
      const entries = postsByProject.get(match.id) ?? [];
      entries.push({
        slug: post.slug,
        url: post.url,
        title: getLocalizedText(post.data.title, locale),
      });
      postsByProject.set(match.id, entries);
    }
  }
}

const sortedProjects: CollectionEntry<'projects'>[] = projects
  .sort((a, b) => {
    const aDate = a.data.date;
    const bDate = b.data.date;
    if (!aDate || !bDate) return 0;
    return bDate.getTime() - aDate.getTime();
  })
  .slice(0, limit);
---

<section class="projects">
  <div class="projects-grid">
    {
      sortedProjects.map((project) => (
        <article class="project-card vhs-card">
          {project.data.image && (
            <div class="project-image">
              <img src={project.data.image} alt={getLocalizedText(project.data.title, locale)} />
            </div>
          )}
          <div class="project-content">
            <h3>{getLocalizedText(project.data.title, locale)}</h3>
            <p class="description">{getLocalizedText(project.data.description, locale)}</p>
            
            {project.data.tags && (
              <div class="tags">
                {project.data.tags.map((tag) => (
                  <span class="tag">
                    <img 
                      src={getTechIconUrl(tag)} 
                      alt={tag} 
                      class="tag-logo"
                      onerror="this.style.display='none'"
                    />
                    <span class="tag-name">{tag}</span>
                  </span>
                ))}
              </div>
            )}
            
            <div class="project-links">
              {project.data.link && (
                <a href={project.data.link} class="btn btn-primary" target="_blank" rel="noopener noreferrer">{t.projects.view}</a>
              )}
              {project.data.github && (
                <a href={project.data.github} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">{t.projects.github}</a>
              )}
            </div>

            {(postsByProject.get(project.id)?.length ?? 0) > 0 && (
              <div class="project-posts">
                {postsByProject.get(project.id)!.map(post => (
                  <a href={post.url} class="project-post-link">
                    <span class="project-post-link-label">{t.projects.readPost}</span>
                    <span class="project-post-link-title">{post.title}</span>
                  </a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .projects {
    width: 100%;
    padding: 2rem 0;
  }

  .projects h2 {
    margin-bottom: 0px;
  }


  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .projects-grid {
      gap: 1rem;
    }
  }


  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 2px solid rgba(255, 236, 200, 0.25);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.55), inset 0 0 20px rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
  }

  .project-card:hover {
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.6), 0 0 18px rgba(199, 255, 107, 0.25);
    transform: translateY(-5px);
  }

  .project-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: linear-gradient(135deg, #1f1f1f 0%, #0c0c0c 100%);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-content {
    padding: 1.5rem;
    background: #0f0f0f;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .project-content h3 {
    margin: 0 0 0.5rem 0;
    color: #f2e8d5;
    text-shadow: 0 1px 0 #000, 0 0 10px rgba(255, 224, 170, 0.4);
    font-size: 1.25rem;
  }

  .description {
    color: #e0c28b;
    font-size: 0.9rem;
    margin-bottom: 1rem;
    flex: 1;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    background: rgba(199, 255, 107, 0.15);
    border: 1px solid rgba(199, 255, 107, 0.6);
    color: #c7ff6b;
    font-size: 0.75rem;
    text-transform: uppercase;
    border-radius: 4px;
  }

  .tag-logo {
    width: 1rem;
    height: 1rem;
    display: inline-block;
  }

  .tag-name {
    font-weight: 500;
  }

  .project-links {
    display: flex;
    gap: 0.5rem;
  }

  .project-posts {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 236, 200, 0.15);
  }

  .project-post-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 0.85rem;
    background: rgba(199, 255, 107, 0.07);
    border: 1px solid rgba(199, 255, 107, 0.35);
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  .project-post-link:hover {
    background: rgba(199, 255, 107, 0.15);
    border-color: #c7ff6b;
    box-shadow: 0 0 16px rgba(199, 255, 107, 0.3);
    transform: translateX(3px);
  }

  .project-post-link:focus-visible {
    outline: 2px solid #c7ff6b;
    outline-offset: 2px;
  }

  .project-post-link-label {
    color: #c7ff6b;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .project-post-link-title {
    color: #f2e8d5;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .btn {
    flex: 1;
    padding: 0.5rem 1rem;
    border: none;
    cursor: pointer;
    text-decoration: none;
    font-size: 0.875rem;
    text-transform: uppercase;
    font-weight: bold;
    text-align: center;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background: #e0c28b;
    color: #0a0a0a;
    box-shadow: 0 0 10px rgba(224, 194, 139, 0.6);
  }

  .btn-primary:hover {
    box-shadow: 0 0 20px rgba(224, 194, 139, 0.9);
  }

  .btn-secondary {
    background: transparent;
    color: #c7ff6b;
    border: 1px solid rgba(199, 255, 107, 0.6);
    box-shadow: 0 0 10px rgba(199, 255, 107, 0.25);
  }

  .btn-secondary:hover {
    box-shadow: 0 0 20px rgba(199, 255, 107, 0.6);
  }
</style>