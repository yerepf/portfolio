---
import { getTechIconId } from '../utils/icons';

interface Props {
  tag: string;
  class?: string;
}

const { tag, class: className } = Astro.props;
const iconId = getTechIconId(tag);
---

{
  iconId && (
    <svg
      class:list={['tech-icon', className]}
      width="16"
      height="16"
      aria-hidden="true"
      focusable="false"
    >
      <use href={`/icons.svg#${iconId}`} />
    </svg>
  )
}

<style>
  .tech-icon {
    width: 1em;
    height: 1em;
    display: inline-block;
    fill: currentColor;
    flex-shrink: 0;
  }
</style>
