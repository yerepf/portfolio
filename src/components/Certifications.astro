---
import { getCollection, type CollectionEntry } from 'astro:content';
import { getTranslationSync, type Locale } from '../i18n';
import { getLocalizedText } from '../utils/content';
import TechIcon from './TechIcon.astro';

interface Props {
  limit?: number;
  locale: Locale;
}

const { limit, locale } = Astro.props;
const t = getTranslationSync(locale);
const certifications = await getCollection('certifications');

const sortedCertifications: CollectionEntry<'certifications'>[] = certifications
  .sort((a, b) => {
    const aDate = a.data.date;
    const bDate = b.data.date;
    if (!aDate || !bDate) return 0;
    return bDate.getTime() - aDate.getTime();
  })
  .slice(0, limit);
---

<section class="certifications">
  <div class="certifications-grid">
    {
      sortedCertifications.map((cert, index) => (
        <article 
          class="certification-card vhs-card" 
          data-cert-index={index}
          data-image={cert.data.image || ''}
          data-link={cert.data.link || ''}
        >
          {cert.data.image && (
            <div class="certification-image">
              <img
                src={cert.data.image}
                alt={getLocalizedText(cert.data.title, locale)}
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="certification-content">
            <h3>{getLocalizedText(cert.data.title, locale)}</h3>
            <p class="issuer">{cert.data.issuer}</p>
            {cert.data.description && (
              <p class="description">{getLocalizedText(cert.data.description, locale)}</p>
            )}
            {cert.data.credentialId && (
              <p class="credential-id">{t.certifications.credentialId} {cert.data.credentialId}</p>
            )}
            {cert.data.tags && (
              <div class="tags">
                {cert.data.tags.map((tag) => (
                  <span class="tag">
                    <TechIcon tag={tag} />
                    <span class="tag-name">{tag}</span>
                  </span>
                ))}
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

<div id="cert-modal" class="modal">
  <div class="modal-content">
    <button class="modal-close" aria-label="Close">&times;</button>
    <img id="modal-image" src="" alt="Certification" />
    <a id="modal-link" href="" target="_blank" rel="noopener noreferrer" class="btn btn-primary">{t.certifications.viewCredential}</a>
  </div>
</div>

<script>
  const cards = document.querySelectorAll('.certification-card');
  const modal = document.getElementById('cert-modal');
  const modalImage = document.getElementById('modal-image') as HTMLImageElement;
  const modalLink = document.getElementById('modal-link') as HTMLAnchorElement;
  const modalClose = document.querySelector('.modal-close');

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const image = card.getAttribute('data-image');
      const link = card.getAttribute('data-link');

      if (image) {
        modalImage.src = image;
        modalImage.style.display = 'block';
      } else {
        modalImage.style.display = 'none';
      }

      if (link) {
        modalLink.href = link;
        modalLink.style.display = 'inline-block';
      } else {
        modalLink.style.display = 'none';
      }

      modal?.classList.add('active');
    });
  });

  modalClose?.addEventListener('click', () => {
    modal?.classList.remove('active');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.remove('active');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('active')) {
      modal.classList.remove('active');
    }
  });
</script>

<style>
  .certifications {
    width: 100%;
    padding: 2rem 0;
  }

  .certifications-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .certifications-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .certifications-grid {
      gap: 1rem;
    }
  }

  .certification-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 2px solid var(--vhs-border);
    box-shadow: 0 10px 30px var(--vhs-shadow), inset 0 0 20px color-mix(in srgb, var(--vhs-accent-tint) 5%, transparent);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .certification-card:hover {
    box-shadow: 0 14px 40px var(--vhs-shadow-soft), 0 0 18px color-mix(in srgb, var(--vhs-accent) 25%, transparent);
    transform: translateY(-3px);
  }

  .certification-image {
    width: 100%;
    min-height: 160px;
    max-height: 420px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--vhs-surface-image-a) 0%, var(--vhs-surface-image-b) 100%);
  }

  .certification-image img {
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: contain;
    display: block;
  }

  .certification-content {
    padding: 1.25rem;
    background: var(--vhs-surface-sunken);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .certification-content h3 {
    margin: 0 0 0.25rem 0;
    color: var(--vhs-cream);
    text-shadow: 0 1px 0 var(--vhs-shadow-hard), 0 0 10px var(--vhs-glow-warm);
    font-size: 1.15rem;
  }

  .issuer {
    color: var(--vhs-accent);
    font-size: 0.85rem;
    margin: 0 0 0.75rem 0;
    text-transform: uppercase;
    font-weight: bold;
  }

  .description {
    color: var(--vhs-warm);
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
    flex: 1;
  }

  .credential-id {
    color: var(--vhs-muted);
    font-size: 1rem;
    margin: 0 0 0.75rem 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    background: color-mix(in srgb, var(--vhs-accent) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--vhs-accent) 60%, transparent);
    color: var(--vhs-accent);
    font-size: 0.7rem;
    text-transform: uppercase;
    border-radius: 4px;
  }

  .tag-name {
    font-weight: 500;
  }

  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--vhs-scrim);
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }

  .modal.active {
    display: flex;
  }

  .modal-content {
    position: relative;
    max-width: 90%;
    max-height: 90%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .modal-close {
    position: absolute;
    top: -40px;
    right: 0;
    background: none;
    border: none;
    color: var(--vhs-cream);
    font-size: 2.5rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.25rem 0.5rem;
  }

  .modal-close:hover {
    color: var(--vhs-accent);
  }

  #modal-image {
    max-width: 100%;
    max-height: 70vh;
    object-fit: contain;
    border: 2px solid var(--vhs-border);
    box-shadow: 0 10px 40px var(--vhs-shadow-deep);
  }

  .btn {
    padding: 0.75rem 2rem;
    border: none;
    cursor: pointer;
    text-decoration: none;
    font-size: 0.9rem;
    text-transform: uppercase;
    font-weight: bold;
    text-align: center;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background: var(--vhs-btn-bg);
    color: var(--vhs-btn-fg);
    box-shadow: 0 0 15px var(--vhs-btn-glow);
  }

  .btn-primary:hover {
    box-shadow: 0 0 25px color-mix(in srgb, var(--vhs-warm-tint) 90%, transparent);
  }
</style>